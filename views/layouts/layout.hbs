<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}} | {{/if}}Bitkart</title>
  <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous">
  <script src="/javascript/shared/validation.js"></script>
  <script src="/javascript/shared/client.js"></script>
</head>

<body>
  {{{body}}}

  {{!-- Alert Box --}}
  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="alert-box" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header bg-danger text-light rounded">
        <strong id="alert-message" class="me-auto">Hello, world! This is a toast message.</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  {{!-- Confirm popup --}}
  <!-- Modal toggle button -->
  <button id="show-confirm-modal-btn" type="button" data-bs-toggle="modal"
    data-bs-target="#confirm-modal" hidden></button>
  <!-- Modal -->
  <div class="modal fade" id="confirm-modal" tabindex="-1" aria-labelledby="confirm-modal-label"
    aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header border border-0">
          <h1 class="modal-title fs-5" id="confirm-modal-label">Do you really want to remove?</h1>
        </div>
        <div class="modal-footer border border-0">
          <button id="close-modal-btn" type="button" class="btn btn-secondary"
            data-bs-dismiss="modal">Close</button>
          <button id="confirm-btn" type="button" class="btn btn-primary"
            onclick="removeAddress('{{_id}}')">Yes</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/javascript/shared/feedback.js"></script>
</body>

</html>
